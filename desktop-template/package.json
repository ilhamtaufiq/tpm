{
  "name": "tpm-super-app-desktop",
  "version": "1.0.0",
  "description": "TPM Super App - Windows Desktop Application",
  "main": "main.js",
  "author": "Olobor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder build --win --publish never",
    "build:dir": "electron-builder build --win --dir",
    "build:portable": "electron-builder build --win portable",
    "build:installer": "electron-builder build --win nsis",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.olobor.tpmsuperapp",
    "productName": "TPM Super App",
    "copyright": "Copyright © 2026 Olobor",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Olobor",
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TPM Super App",
      "include": "installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*",
      "!build/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-store": "^8.1.0"
  }
}
