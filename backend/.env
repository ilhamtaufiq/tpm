# Application
APP_NAME=TPM Backend
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (Laragon MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tpm_db
DB_USER=root
DB_PASSWORD=

# JWT Settings
JWT_SECRET_KEY=tpm-secure-jwt-secret-key-2026-production-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:8081,http://tpm.test,https://tpm.test,https://tpm.cianjur.space

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
