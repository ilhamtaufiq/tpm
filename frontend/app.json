{
  "expo": {
    "name": "TPM Super App",
    "slug": "tpm-super-app",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/logo_tpm.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo_tpm.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.olobor.tpmsuperapp",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_tpm.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 10016
    },
    "web": {
      "favicon": "./assets/favicon2.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      "expo-av",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_tpm.png",
          "color": "#023C69"
        }
      ],
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "minifyEnabled": false,
            "enableProguardInReleaseBuilds": false
          }
        }
      ]
    ],
    "scheme": "tpm",
    "extra": {
      "eas": {
        "projectId": "e9ea627b-eee0-4cc1-9d9e-14268a911a7d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/e9ea627b-eee0-4cc1-9d9e-14268a911a7d",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
